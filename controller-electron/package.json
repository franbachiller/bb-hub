{
  "name": "bb-hub",
  "version": "0.1.22",
  "private": true,
  "description": "BB Hub",
  "type": "module",
  "overrides": {
    "qs": "6.16.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "start": "electron .",
    "protect": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/protect.cjs",
    "sync-runtime": "node scripts/sync-runtime.cjs",
    "pack": "npm run build && npm run protect && electron-builder --dir",
    "dist": "npm run build && npm run protect && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && npm run protect && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@cryptlex/lexactivator": "^3.46.0",
    "bytenode": "^1.7.0",
    "express": "^4.22.1",
    "lucide-react": "^0.468.0",
    "playwright-core": "1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "javascript-obfuscator": "^4.2.2",
    "resedit": "3.1.0",
    "vite": "^5.4.11"
  },
  "build": {
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "appId": "tv.boombang.bbhub",
    "productName": "BB Hub",
    "asar": true,
    "asarUnpack": [
      "node_modules/@cryptlex/lexactivator/**",
      "**/*.node"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "dist-ui/**/*",
      "package.json",
      "!electron/**/*",
      {
        "from": "protected/electron",
        "to": "electron"
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BB Hub Setup ${version}.exe"
    },
    "nsis": {
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "installerHeaderIcon": "electron/assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BB Hub",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "BB Hub Setup ${version}.exe",
      "uninstallDisplayName": "BB Hub"
    }
  }
}
